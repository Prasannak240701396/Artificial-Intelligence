# FINOS Environment Configuration
PROJECT_NAME=FINOS
VERSION=1.0.0
ENVIRONMENT=development

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://finos_user:finos_password@localhost:5432/finos_db
# SQLite fallback if Docker/PostgreSQL is not running:
# DATABASE_URL=sqlite:///./finos.db

# Redis Cache / PubSub
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=finos_secret_key_super_secure_key_2026_academic_fintech
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Market Data Settings
MARKET_DATA_MODE=SIMULATION # LIVE or SIMULATION
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# Server Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
